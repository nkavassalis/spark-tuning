# Node-side settings for the MiMo recipe's launch/serve.sh (copied to <recipe>/launch/mimo.env on BOTH nodes).
# setup_nodes.sh renders this template: __HEAD_LINK_IP__ is read from the head's link interface and
# __HOME__ is the SSH user's home on each node. Nothing site-specific is stored in this repo.
HEAD_IP=__HEAD_LINK_IP__
MASTER_PORT=29650
# Under $HOME, not the recipe's /var/tmp: systemd-tmpfiles ages out /var/tmp (30 days on Ubuntu).
MODEL_DIR=__HOME__/models/MiMo-V2.6-Flash-RL
CACHE=__HOME__/mimo-cache
# DGX Spark defaults for the QSFP/CX7 port (check: ip -br addr ; ibdev2netdev)
IFACE=__IFACE__
HCA=__HCA__
ADDR_RANGE=__ADDR_RANGE__

# Serving: the recipe's measured TP2 defaults, unchanged
TP=2
LINEAR_BACKEND=auto
PORT=8888          # raw vLLM (no tool-call guard). Agents use the toolcap proxy on :8000 instead.
KV_DTYPE=fp8
GMU=0.90
MAXLEN=300000
SEQS=8
SPEC=dflash
THINKING=false     # server default; requests can still pass chat_template_kwargs.enable_thinking
REP_PENALTY=1.05   # server default on top of checkpoint temperature 1.0 / top_p 0.95 (tool-call loop mitigation)
