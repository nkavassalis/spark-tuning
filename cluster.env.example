# Copy to cluster.env (untracked) and fill in. Sourced by scripts/*.sh and mimo/*.sh.
HEAD=user@head-host          # SSH target of the head node (rank 0)
WORKER=user@worker-host      # SSH target of the worker node (rank 1)
API=http://head-host:8000    # OpenAI-compatible base (no /v1) of whatever is serving on :8000
# Paths on the nodes, relative to the SSH user's home directory
REPO=Qwen3.8-Flash-Next-Dual-DGX-Sparks   # Qwen deployment repo checkout (head)
MIMO_RECIPE=mimo-recipe                    # MiMo recipe checkout (both nodes)
