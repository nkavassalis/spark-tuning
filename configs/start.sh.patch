+    fi
     add_overlay "$MTP_DRAFT_VOCAB" "/etc/vllm-draft-vocab.txt"
     OVERLAY_ENV+=("-e VLLM_MTP_DRAFT_VOCAB=/etc/vllm-draft-vocab.txt")
     ok "Draft vocab: $(wc -l < "$MTP_DRAFT_VOCAB") ids from $MTP_DRAFT_VOCAB"
